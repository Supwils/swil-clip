# Release signing & notarization credentials for SwilClip.
#
# Copy this file to `.env.release` and fill in the four values below.
# `.env.release` is gitignored — NEVER commit it or the .p8 key.
#
#   cp .env.release.example .env.release
#
# See docs/releasing.md for how to obtain each value.

# 1. Your "Developer ID Application" identity, copied EXACTLY as printed by:
#       security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# 2. App Store Connect API key, used for notarization.
#    Create at: App Store Connect → Users and Access → Integrations →
#               App Store Connect API → generate a key (role: Developer).
APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"   # Issuer ID (UUID, top of the Keys page)
APPLE_API_KEY="XXXXXXXXXX"                                 # Key ID (10 chars, the key's own ID)
APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
